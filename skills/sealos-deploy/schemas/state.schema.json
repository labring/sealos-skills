{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills.sh/sealos-deploy/schemas/state.schema.json",
  "title": "Sealos Deploy State Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "last_deploy",
    "history"
  ],
  "properties": {
    "version": {
      "type": "string",
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "legacy_history_count": {
      "description": "Explicit migration boundary for a version 1.1 state upgraded from version 1.0. Entries before this count are preserved under the legacy contract; later entries use the version 1.1 contract. Omit for native version 1.1 state.",
      "type": "integer",
      "minimum": 1
    },
    "last_deploy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "app_name",
        "app_host",
        "namespace",
        "region",
        "image",
        "repo_name",
        "url",
        "deployed_at",
        "last_updated_at"
      ],
      "properties": {
        "app_name": {
          "type": "string",
          "minLength": 1
        },
        "app_host": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+$"
        },
        "image": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "services": {
          "description": "Per-container in-place update targets for current workflows. Required semantically for state version 1.1 but may be empty when the verified footprint has no updateable workload.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "primary",
              "workload_kind",
              "workload_name",
              "container_name",
              "image",
              "pull_access",
              "build"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "primary": {
                "type": "boolean"
              },
              "workload_kind": {
                "type": "string",
                "enum": [
                  "Deployment",
                  "StatefulSet",
                  "DaemonSet",
                  "CronJob"
                ]
              },
              "workload_name": {
                "type": "string",
                "minLength": 1
              },
              "container_name": {
                "type": "string",
                "minLength": 1
              },
              "image": {
                "type": "string",
                "pattern": "^[^\\s@]+@sha256:[0-9a-fA-F]{64}$"
              },
              "pull_access": {
                "type": "string",
                "enum": [
                  "anonymous",
                  "ghcr_secret_required",
                  "indeterminate"
                ]
              },
              "build": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "context",
                      "dockerfile",
                      "target",
                      "build_arg_names"
                    ],
                    "properties": {
                      "context": {
                        "type": "string",
                        "minLength": 1
                      },
                      "dockerfile": {
                        "type": "string",
                        "minLength": 1
                      },
                      "target": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "build_arg_names": {
                        "type": "array",
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "docker_hub_user": {
          "description": "Deprecated legacy compatibility field. Current workflows ignore and do not emit it.",
          "deprecated": true,
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "repo_name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^https://"
            },
            {
              "type": "null"
            }
          ]
        },
        "deployed_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "at",
              "action",
              "image",
              "method",
              "status"
            ],
            "properties": {
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "action": {
                "const": "deploy"
              },
              "image": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "method": {
                "type": "string",
                "enum": [
                  "template-api",
                  "kubectl-apply"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "success",
                  "failed"
                ]
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "at",
              "action",
              "previous_image",
              "image",
              "method",
              "status"
            ],
            "properties": {
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "action": {
                "const": "set-image"
              },
              "previous_image": {
                "type": "string",
                "minLength": 1
              },
              "image": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "const": "kubectl-set-image"
              },
              "status": {
                "type": "string",
                "enum": [
                  "success",
                  "failed"
                ]
              },
              "service": {
                "type": "string",
                "minLength": 1
              },
              "workload_kind": {
                "type": "string",
                "enum": [
                  "Deployment",
                  "StatefulSet",
                  "DaemonSet",
                  "CronJob"
                ]
              },
              "workload_name": {
                "type": "string",
                "minLength": 1
              },
              "container_name": {
                "type": "string",
                "minLength": 1
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "at",
              "action",
              "changes",
              "method",
              "status"
            ],
            "properties": {
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "action": {
                "const": "set-env"
              },
              "changes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "method": {
                "const": "kubectl-set-env"
              },
              "status": {
                "type": "string",
                "enum": [
                  "success",
                  "failed"
                ]
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "at",
              "action",
              "changes",
              "method",
              "status"
            ],
            "properties": {
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "action": {
                "const": "patch"
              },
              "changes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "method": {
                "const": "kubectl-patch"
              },
              "status": {
                "type": "string",
                "enum": [
                  "success",
                  "failed"
                ]
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "at",
              "action",
              "method",
              "status"
            ],
            "properties": {
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "action": {
                "const": "restart"
              },
              "method": {
                "const": "kubectl-rollout-restart"
              },
              "status": {
                "type": "string",
                "enum": [
                  "success",
                  "failed"
                ]
              },
              "service": {
                "type": "string",
                "minLength": 1
              },
              "workload_kind": {
                "type": "string",
                "enum": [
                  "Deployment",
                  "StatefulSet",
                  "DaemonSet",
                  "CronJob"
                ]
              },
              "workload_name": {
                "type": "string",
                "minLength": 1
              },
              "container_name": {
                "type": "string",
                "minLength": 1
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    }
  }
}
