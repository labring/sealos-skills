{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills.sh/sealos-deploy/schemas/image-digests.schema.json",
  "title": "Sealos Deploy Image Digests Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["digests"],
  "properties": {
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "digests": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "^.+@sha256:[a-fA-F0-9]{64}$"
      }
    }
  }
}
