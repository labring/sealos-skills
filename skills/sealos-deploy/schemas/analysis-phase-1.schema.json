{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills.sh/sealos-deploy/schemas/analysis-phase-1.schema.json",
  "title": "Sealos Deploy Analysis After Phase 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runtime_profile",
    "work_dir",
    "repo_name",
    "github_url",
    "official_template"
  ],
  "properties": {
    "runtime_profile": {
      "type": "string",
      "enum": ["local", "sandbox"]
    },
    "work_dir": {
      "type": "string",
      "minLength": 1
    },
    "repo_name": {
      "type": "string",
      "minLength": 1
    },
    "github_url": {
      "type": ["string", "null"]
    },
    "official_template": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "const": ".sealos/phase-1/official-template.yaml"
        }
      ]
    }
  }
}
