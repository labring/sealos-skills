{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills.sh/sealos-deploy/schemas/config.schema.json",
  "title": "Sealos Deploy Optional Configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "public_service": {
      "type": "string",
      "minLength": 1
    },
    "deployment_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["helm", "kubernetes", "compose"]
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
