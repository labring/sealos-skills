{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills.sh/sealos-deploy/schemas/build-result.schema.json",
  "title": "Sealos Deploy Build Result Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["pushed"],
  "properties": {
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "pushed": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^@]+$"
      }
    },
    "pull_access": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": ["public", "ghcr_secret_required"]
      }
    }
  }
}
