{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills.sh/sealos-deploy/schemas/build-result.schema.json",
  "title": "Sealos Deploy Phase 3 Build Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["digests", "pull_access"],
  "properties": {
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "digests": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9._-]*$": {
          "type": "string",
          "pattern": "^[^\\s@]+@sha256:[a-fA-F0-9]{64}$"
        }
      }
    },
    "pull_access": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9._-]*$": {
          "type": "string",
          "enum": ["public", "ghcr_secret_required"]
        }
      }
    }
  }
}
