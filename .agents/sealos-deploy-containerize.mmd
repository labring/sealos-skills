flowchart TD
    A["/sealos-deploy<br/>GitHub URL or current sandbox repository"]

    subgraph P0["Phase 0 — Preflight"]
        P01["Resolve and fully materialize exact Git source"]
        P02["Capture clean/default-branch snapshot for official reuse"]
        P03["Select Compose, Helm, Kubernetes, or implicit source"]
        P04["Classify conditional Template and Kaniko capabilities"]
    end

    subgraph P1["Phase 1 — Assess"]
        J{"Certain no reasonable<br/>project-backed online form?"}
        STOP["Stop with one concrete reason"]
        SCORE["Score 0–12<br/>Low score warns and continues"]
        ANALYSIS["Write analysis.json"]
    end

    subgraph O["Phase 1.5 — Official Template"]
        EXACT{"One refreshed, verified,<br/>safe exact spec.gitRepo match?"}
        COPY["Copy official YAML verbatim"]
        OFFBUILD["Write empty official-route<br/>build request + skipped result"]
    end

    subgraph STANDARD["Standard Route"]
        DISCOVER["Phase 2<br/>Discover source, full topology,<br/>declared images and digests"]
        PLAN["Phase 3<br/>Prepare exact per-service<br/>Dockerfile plans"]
        REQUEST["Write aggregate build-request.json"]
        REUSE["Record reusable immutable images"]
        KANIKO["Build missing services with Kaniko<br/>current namespace + service account<br/>VersityGW context → GHCR digest"]
        REPAIR{"Build-plan failure?"}
        RESULT["Complete aggregate build-result.json"]
        TEMPLATE["Phase 5<br/>Source-adapted, digest-pinned Template<br/>inputs remain unresolved"]
    end

    subgraph FINISH["Phase 6 — Finish"]
        SECRET["Private images: reference only<br/>defaults.app_name pull Secret"]
        YAMLVALIDATE["YAML quality gate"]
        MANIFEST["Write delivery-manifest.json"]
        ARTIFACTVALIDATE["Complete JSON +<br/>cross-artifact validation"]
        DONE["Preparation complete<br/>Downstream system deploys later"]
    end

    A --> P01 --> P02 --> P03 --> P04 --> J
    J -- "Yes" --> STOP
    J -- "No / uncertain" --> SCORE --> ANALYSIS --> EXACT
    EXACT -- "Yes" --> COPY --> OFFBUILD --> YAMLVALIDATE
    EXACT -- "No" --> DISCOVER --> PLAN --> REQUEST
    REQUEST --> REUSE
    REQUEST --> KANIKO --> REPAIR
    REPAIR -- "Repair this service; max 3" --> PLAN
    REPAIR -- "No" --> RESULT
    REUSE --> RESULT
    RESULT --> TEMPLATE --> SECRET --> YAMLVALIDATE
    YAMLVALIDATE --> MANIFEST --> ARTIFACTVALIDATE --> DONE
