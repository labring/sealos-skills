flowchart TD
    A["User runs /sealos-deploy<br/>GitHub URL, local path, or current project"]
    P0["Phase 0 - Preflight<br/>Environment, source materialization, and analysis.json"]
    P1{"Phase 1 - Is the project certainly impossible?"}
    Stop1["Stop with one concrete reason"]
    Official{"One eligible exact official template?"}
    P2["Phase 2 - Discover source and prepare images<br/>gitingest, deployment plan, and Dockerfiles"]
    P4Official["Phase 4 - Materialize and gate official YAML<br/>.sealos/template/index.yaml"]
    P4Standard["Phase 4 - Generate and gate YAML<br/>.sealos/template/index.yaml"]
    Build{"Does a repository-built service lack a digest?"}
    P3["Phase 3 - Build and push required images<br/>Sequential linux/amd64 builds and GHCR digests"]
    Stop2["Stop with the exact source, build, conversion, or gate error"]
    Done["YAML prepared<br/>Stop after Phase 4"]

    A --> P0 --> P1
    P1 -- "Yes" --> Stop1
    P1 -- "No or uncertain" --> Official
    Official -- "Yes" --> P4Official --> Done
    Official -- "No" --> P2 --> P4Standard
    P4Standard --> Build
    Build -- "Yes" --> P3 --> P4Standard
    Build -- "No" --> Done
    P2 -- "No complete source" --> Stop2
    P3 -- "Build recipe error" --> P2
    P3 -- "Build or push error" --> Stop2
    P4Official -- "Materialization or gate error" --> Stop2
    P4Standard -- "Conversion or gate error" --> Stop2
